# Copie ce fichier en .env :  cp .env.example .env
# Puis remplis les valeurs (ne publie jamais le vrai .env).

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=5000
CAPTURE_PORT=5001

SEUIL_CONFIANCE_LBPH=70

# --- MQTT (broker Mosquitto, en général sur le même Raspberry Pi) ---
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
TOPIC_CAPTEURS=network/node1/telemetry/msp432

# --- Alertes email (mot de passe d'application Gmail) ---
EMAIL_EXPEDITEUR=votre.email@gmail.com
EMAIL_MOT_DE_PASSE=xxxx xxxx xxxx xxxx
EMAIL_DESTINATAIRE=votre.email@gmail.com

SMTP_SERVEUR=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVEUR=imap.gmail.com
DELAI_VERIF_EMAILS=20
DELAI_MIN_ENTRE_ALERTES=180
